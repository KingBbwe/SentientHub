service : {
  createCharacterProfile: () -> (variant { ok: text; err: text });
  generateQuest: () -> (variant { ok: record {
    id: nat;
    name: text;
    description: text;
    difficultyClass: record {
      value: nat;
      description: text;
      moralComplexity: nat;
    };
    legendaryThreshold: nat;
    hexagramId: nat;
    hexagramTheme: text;
    hexagramDescription: text;
    potentialSkullduggery: nat;
  }; err: text });
  completeQuest: (nat) -> (variant { ok: text; err: text });
  getNarrativeMemory: () -> (vec record {
    id: nat;
    narrativeText: text;
  });
  getVillainyProgress: () -> (record {
    currentLevel: text;
  });
  getVenerableProgress: () -> (record {
    currentLevel: text;
  });
  getResourceBalance: () -> (record {
    crystals: nat;
    inGameFuddy: nat;
    gracePoints: nat;
  });
}
