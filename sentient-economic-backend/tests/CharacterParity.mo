var failures = 0;
for (i in cases.keys()) {
  let (c, expected) = cases[i];
  let got = Character.validate(c);
  if (got != expected) {
    failures += 1;
    Debug.print("MISMATCH case " # debug_show i # "\n  expected " # debug_show expected # "\n  got      " # debug_show got);
  };
};
assert failures == 0;
Debug.print("CharacterParity ok: " # debug_show cases.size() # " cases (25 valid, 436 invalid)");
